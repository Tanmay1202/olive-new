# Frontend Environment Variables (Vite prefixed)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Note: The following server-side secrets are used only by Supabase Edge Functions.
# DO NOT expose these in your frontend .env file!
#
# Set these inside Supabase using the CLI:
#   supabase secrets set RAZORPAY_KEY_ID=xxx RAZORPAY_KEY_SECRET=xxx RAZORPAY_WEBHOOK_SECRET=xxx
#
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key (Auto-available inside Edge Functions)
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
